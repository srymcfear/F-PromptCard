{
  "manifest_version": 3,
  "name": "FPrompt - Image to Prompt AI",
  "version": "1.0",
  "description": "Right-click any image → get a detailed style prompt for AI image generators. Sử dụng Gemini Cookie",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
